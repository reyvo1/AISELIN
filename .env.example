AIOC_ENV=development
# SQLite default for simple local use:
AIOC_DATABASE_PATH=./data/aioc.db
# Production/HA profile can override with PostgreSQL:
# AIOC_DATABASE_URL=postgresql+psycopg://aioc:change-me@postgres:5432/aioc
AIOC_ALLOWED_CONNECTOR_HOSTS=*
AIOC_HTTP_TIMEOUT_SECONDS=15
AIOC_OWNER_TOKEN=change-me
AIOC_EVENT_TOKEN=change-event-me
AIOC_MASTER_KEY=development-master-key-change-me
AIOC_WEBHOOK_TOLERANCE_SECONDS=300
AIOC_CIRCUIT_FAILURE_THRESHOLD=3
AIOC_CIRCUIT_RESET_SECONDS=120
AIOC_WORKER_POLL_SECONDS=5
AIOC_WORKER_LEASE_SECONDS=60
AIOC_MAX_ACTION_ATTEMPTS=3
AIOC_AI_PROVIDER=rules
AIOC_AI_BASE_URL=
AIOC_AI_API_KEY=
AIOC_AI_MODEL=
# Optional multi-provider router JSON. Prefer api_key_env instead of embedding secrets.
# AIOC_AI_PROVIDER=router
# AIOC_AI_PROVIDERS_JSON=[{"name":"primary","base_url":"https://provider.example/v1","api_key_env":"PROVIDER_API_KEY","model":"model-name","priority":10,"daily_request_limit":500,"daily_token_limit":1000000}]
AIOC_AI_DAILY_REQUEST_LIMIT=500
AIOC_AI_DAILY_TOKEN_LIMIT=1000000
AIOC_AI_MAX_PLAN_ACTIONS=12
AIOC_RATE_LIMIT_PER_MINUTE=600
AIOC_MAX_REQUEST_BYTES=1048576

# Edge/local/server agent orchestration
AIOC_AGENT_TASK_LEASE_SECONDS=120
AIOC_AGENT_STALE_SECONDS=90
AIOC_AGENT_MAX_TASK_ATTEMPTS=3
AIOC_ARTIFACT_DIR=./data/artifacts
AIOC_ARTIFACT_MAX_BYTES=536870912
AIOC_ARTIFACT_RETENTION_DAYS=30
AIOC_ARTIFACT_MAX_PER_PROJECT=20
AIOC_DEPLOYMENT_TIMEOUT_SECONDS=1800
