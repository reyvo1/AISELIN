AIOC_CENTRAL_URL=https://aioc.example.com
AIOC_AGENT_ID=dev-laptop-01
AIOC_AGENT_TOKEN=replace-with-token-returned-by-AIOC
AIOC_AGENT_CAPABILITIES=system.status,repo.inspect,repo.prepare_release
AIOC_AGENT_ALLOWED_ROOTS=/home/user/Desktop/program
AIOC_AGENT_ALLOWED_EXECUTABLES=git,python,python3,pytest,npm,pnpm,yarn,composer,php
AIOC_AGENT_POLL_SECONDS=3

# Server-agent additions (only enable what the server is meant to control):
